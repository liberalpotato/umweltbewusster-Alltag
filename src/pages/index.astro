---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BereichKachel from '../components/BereichKachel.astro';
import BeitragKarte from '../components/BeitragKarte.astro';
import { alltagsBereiche } from '../data/alltag';
import { veroeffentlichteRatgeber, sichtbareProdukte } from '../data/inhalte';

const neueste = (await veroeffentlichteRatgeber()).slice(0, 3);
const produkte = await sichtbareProdukte();
const anzahl = (slug: string) => produkte.filter((p) => p.data.bereich === slug).length;
---

<Base titel="Umweltbewusster Alltag" beschreibung="Ehrliche Antworten auf die Frage, was im Alltag wirklich am nachhaltigsten ist: Kochen, Wohnen, Mobilität und Konsum. Unabhängig, mit Quellen." weit>
  <section class="held-flaeche">
    <p class="ueberzeile">Unabhängig · ohne Werbung · mit Quellen</p>
    <h1>Was ist im Alltag wirklich am nachhaltigsten?</h1>
    <p class="lead">Hier findest du ehrliche Antworten auf konkrete Alltagsfragen, mit nachvollziehbaren Quellen. Ich verkaufe nichts und verdiene nichts an Empfehlungen. Deshalb steht oft „brauchst du es überhaupt?“ oder „gebraucht kaufen“ ganz oben.</p>
    <div class="knopf-reihe">
      <a class="knopf" href="/alltag/">Alltagsgegenstände entdecken <Icon name="pfeil" size={18} /></a>
      <a class="knopf knopf-zweit" href="/ratgeber/">Zu den Ratgebern</a>
    </div>
  </section>

  <div class="abschnitt-kopf">
    <h2>Alltagsgegenstände</h2>
    <p><a href="/alltag/">Alle Bereiche</a></p>
  </div>
  <ul class="raster raster-bereiche">
    {alltagsBereiche.map((b) => (
      <li><BereichKachel bereich={b} anzahlProdukte={anzahl(b.slug)} /></li>
    ))}
  </ul>

  {neueste.length > 0 && (
    <>
      <div class="abschnitt-kopf">
        <h2>Neueste Ratgeber</h2>
        <p><a href="/ratgeber/">Alle Ratgeber</a></p>
      </div>
      <ul class="raster raster-beitraege">
        {neueste.map((r) => <li><BeitragKarte beitrag={r} /></li>)}
      </ul>
    </>
  )}
</Base>
