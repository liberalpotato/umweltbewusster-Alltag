---
import Base from '../layouts/Base.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
---

<Base titel="Seite nicht gefunden" beschreibung="Diese Seite gibt es nicht (mehr).">
  <SeitenKopf slot="kopf" farbe="orange" titel="Seite nicht gefunden" icon="frage" klein />
  <div class="artikel artikel-text seiten-start farbe-orange">
