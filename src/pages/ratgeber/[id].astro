---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Quellen from '../../components/Quellen.astro';
import { findeBereich } from '../../data/alltag';
import { veroeffentlichteRatgeber, datum, lesezeit } from '../../data/inhalte';

export async function getStaticPaths() {
  const alle = await veroeffentlichteRatgeber();
  return alle.map((eintrag) => ({ params: { id: eintrag.id }, props: { eintrag } }));
}

const { eintrag } = Astro.props;
const { Content, headings } = await render(eintrag);
const d = eintrag.data;
const bereich = findeBereich(d.bereich);
const bereichLink = bereich?.aktiv ? `/alltag/${bereich.slug}/` : '/alltag/';
const farbe = bereich?.farbe ?? 'mint';
const kapitel = headings.filter((h) => h.depth === 2);
---

<Base titel={d.titel} beschreibung={d.beschreibung} weit lesefortschritt>
  <header slot="kopf" class:list={['artikel-kopf', `farbe-${farbe}`]}>
    <div class="weit artikel-kopf-innen">
      <div class="artikel-kopf-text">
        <a class="rubrik" href={bereichLink}>{bereich?.name ?? d.bereich}</a>
        <h1>{d.titel}</h1>
        <p class="vorspann">{d.beschreibung}</p>
        <p class="autor-zeile">
          <span class="autor-bild" aria-hidden="true">F</span>
          <span>Von <a href="/ueber/">Florian</a></span>
          <span>Stand: {datum(d.stand)}</span>
          <span>{lesezeit(eintrag.body)} Min. Lesezeit</span>
        </p>
      </div>
      {d.titelbild && <img class="artikel-titelbild" src={d.titelbild} alt={d.titelbildAlt ?? ''} width="400" height="360" />}
    </div>
    <svg class="artikel-kopf-welle" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 V30 C240 0 480 0 720 24 C960 48 1200 52 1440 20 V60 Z" /></svg>
  </header>

  <article class:list={['text-mit-rand', 'artikel', `farbe-${farbe}`]}>
    <div class="kurz-kasten">
      <p class="kurz-titel">Das Wichtigste in Kürze</p>
      <p>{d.fazit}</p>
    </div>
    {kapitel.length > 2 && (
      <nav class="rand grafik inhaltsverzeichnis" aria-label="Inhalt">
        <p class="grafik-titel">In diesem Beitrag</p>
        <ol>{kapitel.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="artikel-text">
      <Content />
    </div>
    <Quellen quellen={d.quellen} />
    <p class="hinweis">Keine bezahlten Links, keine Kooperationen. Fehler gefunden oder eine bessere Quelle? Schreib mir über das <a href="/impressum/">Impressum</a>.</p>
  </article>
</Base>
