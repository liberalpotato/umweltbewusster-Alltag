---
import Base from '../../../layouts/Base.astro';
import ProduktKarte from '../../../components/ProduktKarte.astro';
import StatusChip from '../../../components/StatusChip.astro';
import SeitenKopf from '../../../components/SeitenKopf.astro';
import { alltagsBereiche, kriterienFuer } from '../../../data/alltag';
import { sichtbareProdukte } from '../../../data/inhalte';

export async function getStaticPaths() {
  const produkte = await sichtbareProdukte();
  return alltagsBereiche
    .filter((b) => b.aktiv)
    .flatMap((b) =>
      b.unterkategorien
        .map((u) => ({ b, u, liste: produkte.filter((p) => p.data.bereich === b.slug && p.data.unterkategorie === u.slug) }))
        .filter(({ liste }) => liste.length > 0)
        .map(({ b, u, liste }) => ({
          params: { bereich: b.slug, unterkategorie: u.slug },
          props: { bereich: b, unterkategorie: u, produkte: liste },
        })),
    );
}

const { bereich, unterkategorie, produkte } = Astro.props;
const zeigeVergleich = bereich.slug === 'kleidung' && produkte.length > 1;
const kriterien = kriterienFuer(unterkategorie.slug);
---

<Base titel={`Nachhaltige ${unterkategorie.name}`} beschreibung={`${unterkategorie.name} im ehrlichen Nachhaltigkeits-Check: ${produkte.map((p) => p.data.marke).join(', ')} im Vergleich, mit Punktzahl und Quellen.`} weit>
  <SeitenKopf slot="kopf" farbe={bereich.farbe} brotkrumen={[{ name: 'Alltagsgegenstände', href: '/alltag/' }, { name: bereich.name, href: `/alltag/${bereich.slug}/` }, { name: unterkategorie.name }]} titel={unterkategorie.name} lead={`${produkte.length} ${produkte.length === 1 ? 'Produkt' : 'Produkte'} im Check. Ein Klick auf ein Produkt öffnet den ausführlichen Bericht.`} icon={bereich.icon} klein />

  {unterkategorie.wunsch && (
    <aside class="wunsch-kasten seiten-start" aria-labelledby="wunsch-titel">
      <p class="wunsch-titel" id="wunsch-titel">Meine Wunschvorstellung</p>
      <p>{unterkategorie.wunsch.text}</p>
      <ol class="wunsch-schritte">{unterkategorie.wunsch.schritte.map((s) => <li>{s}</li>)}</ol>
      <p class="wunsch-hinweis">So gibt es das heute noch nicht. Die Produkte unten kommen dem unterschiedlich nah.</p>
    </aside>
  )}

  <ul class="raster raster-produkte seiten-start">
    {produkte.map((p) => <li><ProduktKarte produkt={p} /></li>)}
  </ul>

  {zeigeVergleich && (
    <>
      <div class="abschnitt-kopf">
        <h2>Im Vergleich</h2>
        <p><a href={`/alltag/${bereich.slug}/`}>Worauf ich achte</a></p>
      </div>
      <div class="tabelle-rahmen">
        <table class="vergleich">
          <thead>
            <tr>
              <th scope="col">Kriterium</th>
              {produkte.map((p) => (
                <th scope="col"><a href={`/produkte/${p.id}/`}><small>{p.data.marke}</small>{p.data.name}</a></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {kriterien.map((k) => (
              <tr>
                <th scope="row">{k.name}</th>
                {produkte.map((p) => {
                  const kr = p.data.kriterien[k.key];
                  return <td>{kr ? <StatusChip status={kr.status} klein /> : '–'}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>
