---
import Base from '../../layouts/Base.astro';
import BereichKachel from '../../components/BereichKachel.astro';
import { alltagsBereiche } from '../../data/alltag';
import { sichtbareProdukte } from '../../data/inhalte';

const produkte = await sichtbareProdukte();
const anzahl = (slug: string) => produkte.filter((p) => p.data.bereich === slug).length;
---

<Base titel="Alltagsgegenstände" beschreibung="Alltagsgegenstände nachhaltig gedacht: Beiträge und Produkte im ehrlichen Check, von Kleidung bis Garten. Unabhängig und ohne bezahlte Links." weit>
  <section class="held">
    <p class="ueberzeile">Alltagsgegenstände</p>
    <h1>Was du im Alltag brauchst, nachhaltig gedacht</h1>
    <p class="lead">Zu jedem Bereich gibt es Beiträge und Produkte, die ich nach festen Kriterien prüfe. Die Bereiche kommen nach und nach dazu.</p>
  </section>

  <ul class="raster raster-bereiche">
    {alltagsBereiche.map((b) => (
      <li><BereichKachel bereich={b} anzahlProdukte={anzahl(b.slug)} /></li>
    ))}
  </ul>
</Base>
