---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Quellen from '../../components/Quellen.astro';
import { datum } from '../../data/inhalte';

export async function getStaticPaths() {
  const alle = await getCollection('lexikon');
  return alle.map((eintrag) => ({ params: { id: eintrag.id }, props: { eintrag } }));
}

const { eintrag } = Astro.props;
const { Content } = await render(eintrag);
const d = eintrag.data;
---

<Base titel={d.begriff} beschreibung={d.beschreibung}>
  <article>
    <p class="meta"><a href="/lexikon/">Lexikon</a> · Stand: {datum(d.stand)}</p>
    <h1>{d.begriff}</h1>
    <Content />
    <Quellen quellen={d.quellen} />
  </article>
</Base>
